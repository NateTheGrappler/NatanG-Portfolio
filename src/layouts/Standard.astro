---
const { title } = Astro.props;
import "../styles/standardLayout.css"
import DirPath from "../components/DirPath.astro"
---

<html>
    <head><title>{title}</title></head>

    <body>

        <!--Background effect eventually -->
        <div id="bg" aria-hidden="true"></div>
        
        <!--The bar for going to things like projects/about/more etc -->
        <nav class="navBar">
           <div class="marginDiv"></div>
           <DirPath></DirPath>

           <!--Filler div for space -->
           <div class="fillDiv"></div>

           <a class="navlink" href = "/about">About</a>
           <a class="navlink" href = "/projects">Projects</a>
           <a class="navlink" href = "/projects">Rambles</a>
           <a class="navlink" href = "/brain">Resume</a>
           <a class="navlink" href = "/about">More-></a>
           <div class="marginDiv"></div>

        </nav>

        <!--Main content for things like the projects section or the / page -->
        <slot /> 

         <!--footer to display things like time user has spent on site, all of that kind of stuff -->
        <footer class="footy">
           <div class="marginDiv"></div>

            <div class="footerDiv">

                <!--Name and eventual component with pinging the homelab server -->
                <div class="footerLeft">
                    <span class="sep">©</span>
                    <span> Natan Guzinski</span>
                    <span class="sep">-</span>
                    <span>HomeLab Status:</span>
                </div>

                <!--Socials with the links -->
