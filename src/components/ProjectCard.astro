---
import { getEntry } from 'astro:content';
import { getRepo, getLanguages, getStarCount, getContibutors } from '../tools/githubGetter';
import "../styles/projectcard.css"
import { tagColors } from '../tools/tagColors';

interface Props 
{
    id: string;
}

//load in data from the markdown files
const project = await getEntry('projects', Astro.props.id);
if (!project) throw new Error(`No project with id "${Astro.props.id}"`);

const {title, githubLink, repo, terminalDesc, description, tags} = project.data;
const [owner, name] = repo.split("/");

//load in any github data for dynamic rendering at build time
const [repoData, contributors, starCount, languageInformation] = await Promise.all(
    [
        getRepo(githubLink),
        getContibutors(githubLink),
        getStarCount(githubLink),
        getLanguages(githubLink)
    ]
)


---
<a href={"/projects/" + Astro.props.id} class="projectCard">

    <!--This is the terminal like image, as well as text, languages, all the fun visual stuff -->
    <div class="projectCardBackground">
        <div class="projectCardTerminal">
            <!--This would be where the buttons go, the title/owner, all that -->
            <div class="TerminalTop">
                <div class="TerminalTopLeft">
                    <span class={"roundedButton1"}></span>
                    <span class="roundedButton2"></span>
                    <span class="roundedButton3"></span>
                </div>
                
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-star-fill" viewBox="0 0 16 16">
                    <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
                </svg>
                <span class="starCountSpan">{starCount.count}</span>


            </div>

            <div class="TerminalTitleDiv">
                 <span class="TerminalOwnerName">{owner}/ </span>
                 <span class="TerminalName">{name}</span>
            </div>

            <div class="TerminalDescription">
                {terminalDesc}
            </div>

            <div class="TerminalBottom">
                {contributors.length > 0 && (
                    <ul class="avatars">
                    {contributors.slice(0, 5).map((c) => (
                        <li>
                        <img
                            src={`${c.avatar_url}&s=64`}
                            alt={c.login}
                            title={c.login}
                            width="32"
                            height="32"
                            loading="lazy"
                        />
                        </li>
                    ))}
                    </ul>
                )}

                <span class="contribCount">
                    {contributors.length === 1 ? contributors[0].login : `${contributors.length} Contributors`}
                </span>
            </div>

        </div>
    </div>

    <!--This holds the things like the tags, the creator, and the description -->
    <div class="descriptionDiv">
        <h3>{title}</h3>
        <p class="desc">{description}</p>
        <ul class="tags">
            {tags.map((t) => 
            <li 
                style={tagColors[t] 
                ? `--tag-color: ${tagColors[t].foreground}; --tag-bg: ${tagColors[t].background};` 
                : undefined}> {t}
            </li>)}
        </ul>
    </div>
    
</a>



